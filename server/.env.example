# Local:  cp server/.env.example server/.env   (then replace placeholders)
# Vercel: paste each line below as Name / Value (same keys)

PORT=5000
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/linguafirst?retryWrites=true&w=majority
JWT_SECRET=replace-with-long-random-string

# CORS — comma-separated browser origins (local + production in one line, like Inventory Management System)
FRONTEND_URLS=http://localhost:5173,https://your-app.vercel.app
# Optional: merged into the same allowlist as FRONTEND_URLS
# FRONTEND_URL=
# CLIENT_ORIGIN=

# Vercel preview deploys (*.vercel.app) when production URL is already in FRONTEND_URLS
ALLOW_VERCEL_PREVIEWS=true

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
