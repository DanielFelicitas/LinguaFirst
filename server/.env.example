PORT=5000
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/linguafirst?appName=Cluster0
JWT_SECRET=change-this-to-a-long-random-string
# Comma-separated browser origins allowed to call the API (CORS). Required when the client is on another host.
CLIENT_ORIGIN=http://localhost:5173
# Optional: allow any `*.vercel.app` origin (useful for preview deployments). Set to 1 only if you accept that tradeoff.
# ALLOW_VERCEL_PREVIEWS=1

# Cloudinary (admin uploads — e.g. Describe game images). Dashboard: https://cloudinary.com/
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Folder inside Cloudinary (default: linguafirst)
# CLOUDINARY_FOLDER=linguafirst
