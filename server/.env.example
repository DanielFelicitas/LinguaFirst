# ========== SERVER / BACKEND ONLY (never use these names in the React app) ==========
# Copy to .env locally. On Vercel: Settings → Environment Variables (same names).

PORT=5000

# Required — MongoDB connection string (Atlas: Database → Connect → Drivers)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/linguafirst?retryWrites=true&w=majority

# Required — any long random string for JWT signing
JWT_SECRET=change-this-to-a-long-random-string

# When the React app is on another domain (e.g. separate Vercel project), list allowed origins (comma-separated, no spaces after commas is OK)
CLIENT_ORIGIN=http://localhost:5173
# Optional: allow any *.vercel.app (preview URLs)
# ALLOW_VERCEL_PREVIEWS=1

# Cloudinary (admin image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# CLOUDINARY_FOLDER=linguafirst
