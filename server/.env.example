# Local:  cp server/.env.example server/.env   (then replace placeholders)
# Vercel: paste each line below as Name / Value (same keys as Inventory Management System)

PORT=5000
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/linguafirst?retryWrites=true&w=majority
JWT_SECRET=replace-with-long-random-string

# CORS — comma-separated (same pattern as IMS)
FRONTEND_URLS=http://localhost:5173,https://your-app.vercel.app
# Optional: merged into the same allowlist
# FRONTEND_URL=
# CLIENT_ORIGIN=

# Set true to match IMS, or omit on Vercel (defaults to allowing *.vercel.app previews)
ALLOW_VERCEL_PREVIEWS=true

# Cloudinary — use the SAME account as Inventory Management System: copy the three values (or CLOUDINARY_URL) from that project’s Vercel env.
# Dashboard → API Keys: “Cloud name” is a short id (e.g. dxyz123). If trio is set, it wins over CLOUDINARY_URL.
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@cloud_name
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Upload folder in Cloudinary (IMS uses ims_profiles for profile photos; same default here for admin game images)
# CLOUDINARY_FOLDER=ims_profiles
